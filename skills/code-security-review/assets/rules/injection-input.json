{
  "schema_version": 1,
  "category": "injection-input",
  "validator": "sec-val-injection-input",
  "rules": [
    {
      "rule_id": "INJ-001",
      "title": "format string",
      "cwe": "CWE-134",
      "languages": [
        "c",
        "cpp"
      ],
      "pattern": "\\b(?:printf|fprintf|sprintf|snprintf|vprintf|vfprintf|vsprintf|vsnprintf|syslog|vsyslog|err|errx|warn|warnx|NSLog|g_print|dprintf|asprintf|LOG\\w{0,64})\\s*\\(",
      "multiline": false,
      "match_target": "line",
      "why_flagged": "formatted output call; the format argument may not be a literal",
      "flag_condition": "candidate when the format argument is NOT a string literal. The format argument sits at a different position in each of these families (printf 1st, fprintf/syslog/dprintf 2nd), so 'the format is a literal' is not a single line regex and there is no skip path",
      "skip_clause": null,
      "skip_pattern": null,
      "wrapper_class": "printf",
      "threat_model": null,
      "derived": false,
      "high_signal": false,
      "weight": 2
    },
    {
      "rule_id": "INJ-002",
      "title": "command/process exec",
      "cwe": "CWE-78",
      "languages": [
        "c",
        "cpp",
        "rust",
        "go",
        "python",
        "java",
        "javascript",
        "typescript",
        "csharp",
        "php",
        "ruby"
      ],
      "pattern": "\\b(?:system|popen|_popen|execl|execlp|execle|execv|execvp|execve|execvpe|posix_spawn|posix_spawnp|CreateProcess[AW]?|ShellExecute[AW]?|WinExec|fork|vfork|dlopen|LoadLibrary[AW]?)\\s*\\(|Command::new|exec\\.Command|os\\.system|subprocess\\.\\w+\\([^)]{0,500}shell\\s*=\\s*True|Runtime\\.getRuntime\\s*\\(\\s*\\)\\s*\\.\\s*exec|ProcessBuilder\\s*\\(|\\beval\\s*\\(|\\bnew\\s+Function\\s*\\(|child_process\\.\\w+|\\b(?:execSync|execFileSync|spawnSync)\\s*\\(|shell_exec\\s*\\(|passthru\\s*\\(|proc_open\\s*\\(|pcntl_exec\\s*\\(|Kernel\\.(?:system|exec|spawn)\\b|IO\\.popen\\s*\\(|Open3\\.\\w+|Process\\.Start\\s*\\(|(?:[^\\w\\s.$:>\"'`#]\\s*|^\\s*|=>\\s*|:\\s+|\\b(?:return|await|yield|not|and|or|in|else|then|do|echo|print|puts|go|defer|throw|case|when|if|unless|while|until)\\s+)(?:exec|execFile|spawn)\\s*\\(\\s*(?:\\(|$|[^()\\s][^()]{0,300}(?:\\(|$|\\)\\s*(?:[^\\s{]|$)))|\\.(?:execFile|spawn)\\s*\\(|\\b(?:system|exec|spawn)\\s+[\"'`]|(?:^|[=(,!]|\\breturn|\\becho|\\bprint|\\bputs)\\s*(?:`(?:|[^`{$][^`$]{0,300}?)(?:\\$[A-Za-z_]|#\\{)[^`]{0,300}`|%x[({\\[|!])",
      "multiline": false,
      "match_target": "line",
      "why_flagged": "process or library is launched by name",
      "flag_condition": "candidate when any part of the command, its arguments, or the library path is not a literal",
      "skip_clause": null,
      "skip_pattern": null,
      "wrapper_class": null,
      "threat_model": null,
      "derived": false,
      "high_signal": true,
      "weight": 3
    },
    {
      "rule_id": "INJ-003",
      "title": "SQL",
      "cwe": "CWE-89",
      "languages": [
        "c",
        "cpp",
        "rust",
        "go",
        "python",
        "java",
        "javascript",
        "typescript",
        "csharp",
        "php",
        "ruby"
      ],
      "pattern": "\\b(?:sqlite3_exec|sqlite3_prepare\\w{0,16}|mysql_query|mysql_real_query|PQexec|PQexecParams|SQLExecDirect|OCIStmtPrepare|db_query|execute|executemany)\\s*\\(|\\\"(?:SELECT|INSERT|UPDATE|DELETE|DROP)[^\\\"]*\\\"\\s*(?:\\+|,)|strcat.{0,500}SELECT|\\b(?:mysqli_query|mysqli_real_query|mysqli_multi_query|pg_query|pg_send_query|find_by_sql)\\s*\\(|\\b(?:executeQuery|executeUpdate)\\s*\\(\\s*[^)\\s]|->\\s*(?:query|exec)\\s*\\(\\s*(?:[^)\\s]|$)|\"(?i:select\\s[^\"]{0,200}?\\bfrom\\b|insert\\s+into\\b|update\\s+[^\\s\"]+\\s+set\\b|delete\\s+from\\b|drop\\s+table\\b)[^\"]{0,500}(?:\"\\s*[+,.%]|\\$\\{|#\\{|\\$[A-Za-z_]|\\{[A-Za-z_])|'(?i:select\\s[^']{0,200}?\\bfrom\\b|insert\\s+into\\b|update\\s+[^\\s']+\\s+set\\b|delete\\s+from\\b|drop\\s+table\\b)[^']{0,500}(?:'\\s*[+.%]|\\{[A-Za-z_])|`(?i:select\\s[^`]{0,200}?\\bfrom\\b|insert\\s+into\\b|update\\s+[^\\s`]+\\s+set\\b|delete\\s+from\\b|drop\\s+table\\b)[^`]{0,500}(?:\\$\\{|#\\{|`\\s*[+.])",
      "multiline": false,
      "match_target": "line",
      "why_flagged": "SQL statement is executed, or a SQL string is being built by concatenation",
      "flag_condition": "candidate when the statement text is built rather than a bound-parameter literal - concatenation, sprintf/format-built SQL, or strcat onto a SELECT",
      "skip_clause": null,
      "skip_pattern": null,
      "wrapper_class": null,
      "threat_model": null,
      "derived": false,
      "high_signal": true,
      "weight": 3
    },
    {
      "rule_id": "INJ-004",
      "title": "path traversal",
      "cwe": "CWE-22",
      "languages": [
        "c",
        "cpp",
        "rust",
        "go",
        "python",
        "java",
        "javascript",
        "typescript",
        "csharp",
        "php",
        "ruby"
      ],
      "pattern": "\\b(?:fopen|fopen_s|open|openat|creat|unlink|unlinkat|remove|rename|renameat|mkdir|rmdir|opendir|stat|lstat|access|chmod|chown|truncate|symlink|link|CreateFile[AW]?|DeleteFile[AW]?|_wfopen)\\s*\\(|\\b(?:os|ioutil)\\.(?:Open|OpenFile|Create|ReadFile|WriteFile|ReadDir|Remove|RemoveAll|Mkdir|MkdirAll|Rename|Chmod|Chown|Symlink|Stat|Lstat)\\s*\\(|\\bhttp\\.(?:ServeFile|Dir)\\s*\\(|\\bnew\\s+(?:[\\w.]+\\.)?(?:File|FileInputStream|FileOutputStream|FileReader|FileWriter|RandomAccessFile|FileStream|StreamReader|StreamWriter|FileInfo|DirectoryInfo)\\s*\\(|\\b(?:Paths\\.get|Path\\.of|Path\\.Combine|Files\\.\\w+|File\\.\\w+|Directory\\.\\w+|IO\\.(?:read|readlines|write|binread))\\s*\\(|\\bFile\\.(?:read|open|write|delete|readlines|binread)\\b|\\b(?:fs|fsp|fsPromises)(?:\\.promises)?\\.\\w+\\s*\\(|\\b(?:sendFile|send_file|send_from_directory|createReadStream|createWriteStream|readFileSync|writeFileSync)\\s*\\(|\\b(?:file_get_contents|file_put_contents|readfile|fpassthru|move_uploaded_file)\\s*\\(|\\b(?:include|require)(?:_once)?\\b[^;]{0,300}\\$[A-Za-z_{]|\\bfs::\\w+\\s*\\(|\\bFile::create\\s*\\(|\\bshutil\\.\\w+\\s*\\(|(?:[^\\w\\s.$:>\"'`#]\\s*|^\\s*|=>\\s*|:\\s+|\\b(?:return|await|yield|not|and|or|in|else|then|do|echo|print|puts|go|defer|throw|case|when|if|unless|while|until)\\s+)(?:readFile|writeFile|appendFile|readdir|copyFile|readlink|rm|cp|mkdtemp|mkdir|rmdir|unlink|rename|stat|lstat|access|exists|open|opendir)(?:Sync)?\\s*\\(\\s*(?:\\(|$|[^()\\s][^()]{0,300}(?:\\(|$|\\)\\s*(?:[^\\s{]|$)))",
      "multiline": false,
      "match_target": "line",
      "why_flagged": "filesystem call whose path argument may be attacker-influenced",
      "flag_condition": "candidate when the path argument involves concatenation, sprintf, strcat, or a parameter",
      "skip_clause": null,
      "skip_pattern": null,
      "wrapper_class": null,
      "threat_model": null,
      "derived": false,
      "high_signal": false,
      "weight": 2
    },
    {
      "rule_id": "INJ-005",
      "title": "SSRF",
      "cwe": "CWE-918",
      "languages": [
        "c",
        "cpp",
        "rust",
        "go",
        "python",
        "java",
        "javascript",
        "typescript",
        "csharp",
        "php",
        "ruby"
      ],
      "pattern": "CURLOPT_URL|curl_easy_setopt|\\b(?:getaddrinfo|gethostbyname|connect|http_get|HttpOpenRequest|WinHttpOpenRequest)\\s*\\(|requests\\.(?:get|post)|urllib|fetch\\(|http\\.(?:Get|Post)|\\bhttp\\.(?:Head|PostForm|NewRequest|NewRequestWithContext)\\s*\\(|\\bnet\\.Dial\\w{0,32}\\s*\\(|\\.openStream\\s*\\(|\\bURI\\.create\\s*\\(|\\.openConnection\\s*\\(|\\bHttpRequest\\.newBuilder\\b|\\.(?:GetAsync|PostAsync|PutAsync|SendAsync|GetStringAsync|GetStreamAsync|GetByteArrayAsync|DownloadString|DownloadData|DownloadFile)\\s*\\(|\\bWebRequest\\.Create\\s*\\(|\\baxios(?:\\.\\w+)?\\s*\\(|\\bhttps?\\.(?:get|request)\\s*\\(|\\b(?:requests|httpx)\\.(?:get|post|put|patch|delete|head|options|request|Request|stream|Session|session|Client|AsyncClient)\\s*\\(|\\burlopen\\s*\\(|\\b(?:aiohttp\\.\\w+|ClientSession)\\s*\\(|\\bNet::HTTP\\b|\\bURI\\.open\\b|\\b(?:HTTParty|Faraday|RestClient)\\b|\\b(?:reqwest|ureq)::(?:\\w+::){0,3}\\w+\\s*\\(|\\buse\\s+(?:reqwest|ureq)\\b|\\b(?:curl_init|curl_setopt|fsockopen)\\s*\\(",
      "multiline": false,
      "match_target": "line",
      "why_flagged": "outbound request whose destination may not be a literal",
      "flag_condition": "candidate when the host or URL is not a literal",
      "skip_clause": null,
      "skip_pattern": null,
      "wrapper_class": null,
      "threat_model": null,
      "derived": false,
      "high_signal": false,
      "weight": 2
    },
    {
      "rule_id": "INJ-006",
      "title": "numeric conversion",
      "cwe": "CWE-190",
      "languages": [
        "c",
        "cpp"
      ],
      "pattern": "\\b(?:atoi|atol|atoll|atof|strtol|strtoul|strtoll|strtoull|sscanf)\\s*\\(|\\((?:unsigned\\s+)?(?:char|short|int|int8_t|int16_t|int32_t|uint8_t|uint16_t|uint32_t)\\)\\s*\\w|\\b(?:ntohs|ntohl|be\\d+toh|le\\d+toh)\\b",
      "multiline": false,
      "match_target": "line",
      "why_flagged": "value crosses a width or signedness boundary without a range check",
      "flag_condition": "also flag assignment of size_t/ssize_t/long into int, and ntoh*/le*toh results used in arithmetic. Scout table records this rule as CWE-190/197; CWE-190 is carried on the record",
      "skip_clause": null,
      "skip_pattern": null,
      "wrapper_class": null,
      "threat_model": null,
      "derived": false,
      "high_signal": false,
      "weight": 2
    }
  ]
}
