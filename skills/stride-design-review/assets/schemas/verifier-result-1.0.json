{
  "title": "STRIDE verifier result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "queueKey", "issueId", "origin", "attempt", "verdict", "blockedCause", "citationIntegrity", "correctedClaim", "stride", "scope", "supportingEvidence", "contradictingEvidence", "documentedControls", "severity", "confidence", "dispositionRecommendation", "missingInformation", "verificationDefects"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "protocolVersion": {"const": "2.0"}, "queueKey": {"type": "string", "minLength": 1}, "issueId": {"type": "string"},
    "origin": {"enum": ["stage1", "stage2", "stage3"]}, "attempt": {"enum": [1, 2, "inline"]},
    "verdict": {"enum": ["Confirmed", "Partially confirmed", "False positive", "Unverifiable", "Blocked"]},
    "blockedCause": {"enum": [null, "invalid invocation", "unreadable source", "digest mismatch", "transient execution"]},
    "citationIntegrity": {"enum": ["Valid", "Wrong locator", "Overstated", "Not found", "No citation", "Mixed"]}, "correctedClaim": {"type": ["string", "null"]},
    "stride": {"type": "array", "uniqueItems": true, "items": {"enum": ["Spoofing", "Tampering", "Repudiation", "Information Disclosure", "Denial of Service", "Elevation of Privilege"]}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["elements", "interactions", "trustBoundaries", "claims", "claimDependencies", "threatActors"], "properties": {"elements": {"$ref": "#/$defs/stringArray"}, "interactions": {"$ref": "#/$defs/stringArray"}, "trustBoundaries": {"$ref": "#/$defs/stringArray"}, "claims": {"$ref": "#/$defs/stringArray"}, "claimDependencies": {"$ref": "#/$defs/stringArray"}, "threatActors": {"$ref": "#/$defs/stringArray"}}},
    "supportingEvidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "contradictingEvidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "documentedControls": {"type": "array", "items": {"$ref": "#/$defs/control"}},
    "severity": {"type": "object", "additionalProperties": false, "required": ["base", "rubricCell", "basis", "conditionalCeiling", "condition", "gatedBy"], "properties": {"base": {"$ref": "#/$defs/severity"}, "rubricCell": {"enum": ["SR-Critical", "SR-High", "SR-Medium", "SR-Low", "SR-Undetermined"]}, "basis": {"type": "string", "minLength": 1}, "conditionalCeiling": {"anyOf": [{"$ref": "#/$defs/severity"}, {"type": "null"}]}, "condition": {"type": ["string", "null"]}, "gatedBy": {"type": "array", "uniqueItems": true, "items": {"pattern": "^MI-S[123]-[0-9]{3,}$"}}}},
    "confidence": {"type": "object", "additionalProperties": false, "required": ["value", "basis"], "properties": {"value": {"enum": ["High", "Medium", "Low"]}, "basis": {"type": "string", "minLength": 1}}},
    "dispositionRecommendation": {"enum": ["Keep", "Correct", "Merge", "Withdraw", "Move to Missing Information", "Verification defect only", "No final finding", "Candidate final finding", "Blocked"]},
    "missingInformation": {"type": "array", "items": {"$ref": "#/$defs/missingInformation"}}, "verificationDefects": {"type": "array", "items": {"$ref": "#/$defs/defect"}}
  },
  "$defs": {
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "severity": {"enum": ["Critical", "High", "Medium", "Low", "Undetermined"]},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["documentTitle", "relativePath", "locator", "quote", "proposition"], "properties": {"documentTitle": {"type": "string", "minLength": 1}, "relativePath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}, "locator": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}, "proposition": {"type": "string", "minLength": 1}}},
    "control": {"type": "object", "additionalProperties": false, "required": ["controlReference", "documentTitle", "relativePath", "locator", "quote", "mechanism", "applicability", "effect"], "properties": {"controlReference": {"type": ["string", "null"]}, "documentTitle": {"type": "string", "minLength": 1}, "relativePath": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}, "mechanism": {"type": "string", "minLength": 1}, "applicability": {"type": "string", "minLength": 1}, "effect": {"enum": ["Eliminates", "Reduces", "Does not address", "Undetermined"]}}},
    "missingInformation": {"type": "object", "additionalProperties": false, "required": ["question", "blocks", "searched", "whyItMatters"], "properties": {"question": {"type": "string", "minLength": 1}, "blocks": {"$ref": "#/$defs/stringArray"}, "whyItMatters": {"type": "string", "minLength": 1}, "searched": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["documentTitle", "relativePath", "locators"], "properties": {"documentTitle": {"type": "string", "minLength": 1}, "relativePath": {"type": "string", "minLength": 1}, "locators": {"$ref": "#/$defs/stringArray"}}}}}},
    "defect": {"type": "object", "additionalProperties": false, "required": ["type", "affectedReference", "detail", "resolution", "effectOnVerdict"], "properties": {"type": {"type": "string", "minLength": 1}, "affectedReference": {"type": "string"}, "detail": {"type": "string", "minLength": 1}, "resolution": {"type": "string", "minLength": 1}, "effectOnVerdict": {"type": "string", "minLength": 1}}}
  },
  "allOf": [
    {"if": {"properties": {"verdict": {"enum": ["Confirmed", "Partially confirmed"]}}}, "then": {"properties": {"supportingEvidence": {"minItems": 1}}}},
    {"if": {"properties": {"verdict": {"const": "False positive"}}}, "then": {"properties": {"contradictingEvidence": {"minItems": 1}}}},
    {"if": {"properties": {"verdict": {"const": "Unverifiable"}}}, "then": {"properties": {"missingInformation": {"minItems": 1}}}},
    {"if": {"properties": {"verdict": {"const": "Blocked"}}}, "then": {"properties": {"blockedCause": {"not": {"type": "null"}}, "verificationDefects": {"minItems": 1}}}},
    {"if": {"properties": {"verdict": {"not": {"const": "Blocked"}}}}, "then": {"properties": {"blockedCause": {"type": "null"}}}}
  ]
}
